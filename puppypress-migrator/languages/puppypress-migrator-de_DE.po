msgstr "%1$d Begriffe, %2$d Kommentare, %3$d Mediendateien."

#: includes/Exporter.php:131 includes/Importer.php:729
msgid "The ZIP file could not be opened."
msgstr "Die ZIP-Datei konnte nicht geöffnet werden."

#. translators: %s: file size
#: includes/Exporter.php:164
