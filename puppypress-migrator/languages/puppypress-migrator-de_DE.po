msgstr "Das Paket wurde mit einer neueren Version von PuppyPress Migrator erstellt. Bitte aktualisieren Sie das Plugin."

#: includes/Importer.php:120
msgid "The package was exported from this site. Existing records are skipped."
msgstr "Das Paket wurde aus dieser Website exportiert. Vorhandene Einträge werden übersprungen."

#. translators: 1: site name, 2: URL, 3: date
#: includes/Importer.php:124
msgid "Package from \"%1$s\" (%2$s), exported %3$s."
msgstr "Paket von „%1$s“ (%2$s), exportiert am %3$s."

#: includes/Importer.php:127
msgid "PuppyPress is not active. Club post types and taxonomies are missing; activate PuppyPress before importing."
msgstr "PuppyPress ist nicht aktiv. Vereins-Inhaltstypen und -Taxonomien fehlen; bitte aktivieren Sie PuppyPress vor dem Import."

#. translators: %s: list of post types
#: includes/Importer.php:133
msgid "These post types are not registered on this site and will still be imported: %s"
msgstr "Diese Inhaltstypen sind auf dieser Website nicht registriert und werden trotzdem importiert: %s"

#. translators: %s: list of taxonomies
#: includes/Importer.php:139
msgid "These taxonomies are not registered on this site and will be skipped: %s"
msgstr "Diese Taxonomien sind auf dieser Website nicht registriert und werden übersprungen: %s"

#. translators: %d: number of posts
#: includes/Importer.php:158
msgid "%d posts from this package already exist and will be skipped."
msgstr "%d Beiträge aus diesem Paket sind bereits vorhanden und werden übersprungen."

#. translators: %s: file path
#: includes/Importer.php:211
