msgstr "Widgets aus dieser Quelle wurden bereits importiert und werden übersprungen."

#: includes/Importer.php:607
msgid "Front page set."
msgstr "Startseite festgelegt."

#: includes/Importer.php:625
msgid "Menu locations assigned."
msgstr "Menüpositionen zugewiesen."

#. translators: 1: posts, 2: terms created, 3: terms reused, 4: comments, 5: files
#: includes/Importer.php:696
msgid "Import finished: %1$d posts, %2$d new terms (%3$d reused), %4$d comments, %5$d files."
msgstr "Import abgeschlossen: %1$d Beiträge, %2$d neue Begriffe (%3$d wiederverwendet), %4$d Kommentare, %5$d Dateien."

#. translators: %d: number of references
#: includes/Importer.php:707
msgid "%d references pointed to content that is not part of the package and were removed."
msgstr "%d Verweise zeigten auf Inhalte, die nicht im Paket enthalten sind, und wurden entfernt."

#: includes/Importer.php:750
msgid "The job data is incomplete. Please start the import again."
msgstr "Die Vorgangsdaten sind unvollständig. Bitte starten Sie den Import erneut."

#. translators: 1: user login, 2: error message
#: includes/Importer.php:888
