#: includes/Admin/Page.php:52 includes/Admin/Page.php:53 includes/Admin/Page.php:101
msgid "PuppyPress Migration"
msgstr "PuppyPress-Migration"

#: includes/Admin/Page.php:79
msgid "Starting …"
msgstr "Starte …"

#: includes/Admin/Page.php:80
msgid "Done."
msgstr "Fertig."

#: includes/Admin/Page.php:81
msgid "Failed:"
msgstr "Fehlgeschlagen:"

#: includes/Admin/Page.php:82
msgid "Download export"
msgstr "Export herunterladen"

#: includes/Admin/Page.php:83
msgid "The request failed. The job continues where it stopped when you retry."
msgstr "Die Anfrage ist fehlgeschlagen. Beim erneuten Versuch macht der Vorgang dort weiter, wo er aufgehört hat."

#: includes/Admin/Page.php:84
msgid "Retry"
msgstr "Erneut versuchen"

#: includes/Admin/Page.php:85 includes/Admin/Page.php:360
msgid "Please choose a ZIP file."
msgstr "Bitte wählen Sie eine ZIP-Datei."

#: includes/Admin/Page.php:86
msgid "Start the import into this site now? Please make sure you have a backup."
msgstr "Import in diese Website jetzt starten? Bitte stellen Sie sicher, dass ein Backup vorhanden ist."

#: includes/Admin/Page.php:87
msgid "A migration is running. Leaving the page pauses it."
msgstr "Eine Migration läuft. Wenn Sie die Seite verlassen, wird sie pausiert."

#: includes/Admin/Page.php:102
msgid "Moves all club data from a site with the former \"Extra Child\" theme to a site with PuppyPress: stud dogs with pedigrees, litters, dogs to place, approvals, breeding licenses, results, kennels, breeders, owners, media, menus, widgets and more. All references between records are rewritten to the new IDs."
msgstr "Überträgt alle Vereinsdaten von einer Website mit dem bisherigen Theme „Extra Child“ auf eine Website mit PuppyPress: Deckrüden mit Abstammung, Würfe, Vermittlungshunde, Körberichte, Zuchtzulassungen, Ergebnisse, Zwinger, Züchter, Besitzer, Medien, Menüs, Widgets und mehr. Alle Verweise zwischen den Einträgen werden auf die neuen IDs umgeschrieben."

#: includes/Admin/Page.php:105
msgid "The PHP extension \"zip\" (ZipArchive) is missing. Please ask your host to enable it."
msgstr "Die PHP-Erweiterung „zip“ (ZipArchive) fehlt. Bitte bitten Sie Ihren Hoster, sie zu aktivieren."

#: includes/Admin/Page.php:110
msgid "Export (old site)"
msgstr "Export (alte Website)"

#: includes/Admin/Page.php:113
msgid "What to export"
msgstr "Was exportiert wird"

#: includes/Admin/Page.php:114
msgid "Club data (always included)"
msgstr "Vereinsdaten (immer enthalten)"

#: includes/Admin/Page.php:115
msgid "Posts and pages"
msgstr "Beiträge und Seiten"

#: includes/Admin/Page.php:116
msgid "Menus"
msgstr "Menüs"

#: includes/Admin/Page.php:117
msgid "Comments"
msgstr "Kommentare"

#: includes/Admin/Page.php:118
msgid "Widgets"
msgstr "Widgets"

#: includes/Admin/Page.php:120
msgid "Media files"
msgstr "Mediendateien"

#: includes/Admin/Page.php:122
msgid "Entire media library"
msgstr "Gesamte Mediathek"

#: includes/Admin/Page.php:123
msgid "Only media used by the exported content"
msgstr "Nur Medien, die in den exportierten Inhalten verwendet werden"

#: includes/Admin/Page.php:124
msgid "No media files"
msgstr "Keine Mediendateien"

#: includes/Admin/Page.php:128
msgid "Create export"
msgstr "Export erstellen"

#: includes/Admin/Page.php:132
msgid "Existing exports"
msgstr "Vorhandene Exporte"

#: includes/Admin/Page.php:138
msgid "Delete"
msgstr "Löschen"

#: includes/Admin/Page.php:142
msgid "Exports contain personal data (addresses, phone numbers, emails). They are deleted automatically after three days."
msgstr "Exporte enthalten personenbezogene Daten (Adressen, Telefonnummern, E-Mails). Sie werden nach drei Tagen automatisch gelöscht."

#: includes/Admin/Page.php:147
msgid "Import (new site with PuppyPress)"
msgstr "Import (neue Website mit PuppyPress)"

#: includes/Admin/Page.php:150
msgid "PuppyPress is not active on this site. Activate it before importing, otherwise club taxonomies cannot be assigned."
msgstr "PuppyPress ist auf dieser Website nicht aktiv. Bitte aktivieren Sie es vor dem Import, sonst können die Vereins-Taxonomien nicht zugeordnet werden."

#: includes/Admin/Page.php:155
msgid "Migration package (ZIP)"
msgstr "Migrationspaket (ZIP)"

#. translators: %s: maximum upload size
#: includes/Admin/Page.php:160
msgid "Maximum upload size: %s."
msgstr "Maximale Upload-Größe: %s."

#: includes/Admin/Page.php:167
msgid "Or use a file from the incoming folder"
msgstr "Oder eine Datei aus dem Eingangsordner verwenden"

#: includes/Admin/Page.php:169
msgid "— Upload above —"
msgstr "— Upload oben verwenden —"

#. translators: %s: folder path
#: includes/Admin/Page.php:180
msgid "Large packages: upload them via FTP/SFTP to %s and reload this page."
msgstr "Große Pakete: per FTP/SFTP nach %s hochladen und diese Seite neu laden."

#: includes/Admin/Page.php:185
msgid "Import options"
msgstr "Import-Optionen"

#: includes/Admin/Page.php:186
msgid "Replace links to the old domain with this site"
msgstr "Links auf die alte Domain durch diese Website ersetzen"

#: includes/Admin/Page.php:187
msgid "Import widgets"
msgstr "Widgets importieren"

#: includes/Admin/Page.php:188
msgid "Apply front page, sticky posts and menu locations"
msgstr "Startseite, oben gehaltene Beiträge und Menüpositionen übernehmen"

#: includes/Admin/Page.php:189
msgid "Create missing authors (with random passwords)"
msgstr "Fehlende Autoren anlegen (mit zufälligen Passwörtern)"

#: includes/Admin/Page.php:191
msgid "Otherwise assign their content to"
msgstr "Sonst deren Inhalte zuordnen an"

#: includes/Admin/Page.php:204
msgid "Start import"
msgstr "Import starten"

#: includes/Admin/Page.php:206
msgid "Records that already exist from an earlier run of the same package are skipped, so an interrupted import can simply be started again."
msgstr "Einträge, die aus einem früheren Lauf desselben Pakets schon vorhanden sind, werden übersprungen. Ein abgebrochener Import kann daher einfach neu gestartet werden."

#: includes/Admin/Page.php:250
msgid "Job not found."
msgstr "Vorgang nicht gefunden."

#: includes/Admin/Page.php:271
msgid "Export not found."
msgstr "Export nicht gefunden."

#: includes/Admin/Page.php:346
msgid "The selected file does not exist."
msgstr "Die ausgewählte Datei existiert nicht."

#: includes/Admin/Page.php:356
msgid "The upload failed. The file may be larger than the maximum upload size; use the incoming folder instead."
msgstr "Der Upload ist fehlgeschlagen. Die Datei ist eventuell größer als die maximale Upload-Größe; verwenden Sie stattdessen den Eingangsordner."

#: includes/Admin/Page.php:367
msgid "The uploaded file could not be stored."
msgstr "Die hochgeladene Datei konnte nicht gespeichert werden."

#. translators: 1: files done, 2: total files
#: includes/Admin/Page.php:387
