msgstr "Mediendatei fehlt oder ist nicht erlaubt, übersprungen: %s"

#: includes/Importer.php:101
msgid "This is not a PuppyPress migration package (data.json is missing)."
msgstr "Dies ist kein PuppyPress-Migrationspaket (data.json fehlt)."

#: includes/Importer.php:107
msgid "This is not a PuppyPress migration package."
msgstr "Dies ist kein PuppyPress-Migrationspaket."

#: includes/Importer.php:111
